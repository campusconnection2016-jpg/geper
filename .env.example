# Public site origin (used for canonical URLs and sitemap). No trailing slash.
PUBLIC_SITE_URL=https://www.geper.example

# Email shown on the Contact page and used for the mailto fallback.
PUBLIC_CONTACT_EMAIL=mailgeper@gmail.com

# Optional. HTTPS endpoint that accepts the contact form (see README "Contact endpoint contract").
# Leave empty to make the form open the visitor's email client instead (mailto fallback).
PUBLIC_CONTACT_ENDPOINT=

# Optional. URL of an analytics script to include in <head>. Empty = no analytics.
PUBLIC_ANALYTICS_SRC=
